[
 {
  "label": "cfg-R1",
  "tool": "pt_cli",
  "args": {
   "device": "R1",
   "commands": [
    "enable",
    "configure terminal",
    "hostname R1",
    "service password-encryption",
    "no ip domain-lookup",
    "ip domain-name lab.local",
    "enable secret Cisco12345",
    "username admin privilege 15 secret Ssh12345",
    "banner motd #Acces reserve - Etude de cas 9.4 - R1#",
    "interface FastEthernet0/0",
    "description LAN1 10 hotes zone OSPF 1",
    "ip address 192.168.1.1 255.255.255.240",
    "ip ospf authentication-key TRI123",
    "no shutdown",
    "exit",
    "interface Serial0/0/0",
    "description Vers R2 zone OSPF 1",
    "ip address 192.168.1.33 255.255.255.252",
    "ip ospf authentication-key TRI123",
    "clock rate 64000",
    "no shutdown",
    "exit",
    "router ospf 1",
    "router-id 10.1.1.1",
    "area 1 authentication",
    "passive-interface FastEthernet0/0",
    "network 192.168.1.0 0.0.0.15 area 1",
    "network 192.168.1.32 0.0.0.3 area 1",
    "exit",
    "ip dhcp excluded-address 192.168.1.1 192.168.1.10",
    "ip dhcp excluded-address 192.168.1.17 192.168.1.19",
    "ip dhcp pool LAN1",
    "network 192.168.1.0 255.255.255.240",
    "default-router 192.168.1.1",
    "dns-server 8.8.8.8",
    "exit",
    "ip dhcp pool LAN2",
    "network 192.168.1.16 255.255.255.240",
    "default-router 192.168.1.17",
    "dns-server 8.8.8.8",
    "exit",
    "line con 0",
    "password Con12345",
    "login",
    "logging synchronous",
    "exit",
    "line vty 0 4",
    "login local",
    "transport input ssh",
    "exit",
    "ip ssh version 2",
    "crypto key generate rsa modulus 1024",
    "end",
    "write memory"
   ],
   "timeout": 240,
   "auto_confirm": true
  },
  "timeout": 900
 },
